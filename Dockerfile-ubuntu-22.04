# NOTE: We try to support Ubuntu 22.04 environment as it is the latest Ubuntu
# LTS release.

# Download base image ubuntu 22.04
FROM ubuntu:22.04

RUN git clone https://github.com/MikePopoloski/slang /tmp/slang_git && \
    cd /tmp/slang_git && \
    git checkout f04e81565793c768b747a8fd058f3e7aeceee1b5

RUN git clone https://github.com/bazelbuild/bazel-central-registry /tmp/bcr_git

RUN mkdir -p /opt/sv-lang/slang-f04e81565793c768b747a8fd058f3e7aeceee1b5

RUN cp -r /tmp/bcr_git/modules/sv-lang/10.0.1-20260316-f04e8156/overlay/* /opt/sv-lang/

RUN cp -r /tmp/slang_git/* /opt/sv-lang/slang-f04e81565793c768b747a8fd058f3e7aeceee1b5/

RUN rm -rf /tmp/slang_git /tmp/bcr_git

ARG SKIP_TESTS=0

# LABEL about the custom image
LABEL version="0.1"
LABEL description="Docker Image for Building/Testing XLS on Ubuntu 22.04 x86-64"

# Update package info
RUN apt-get update -y

# Install bazelisk from latest release
RUN apt-get install -y curl python3
RUN curl -O -L $(curl -L \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  https://api.github.com/repos/bazelbuild/bazelisk/releases | \
  python3 -c 'import json; import sys; print(filter(lambda url: "linux-amd64" in url, (a["browser_download_url"] for a in json.load(sys.stdin)[0]["assets"])).__next__())')

RUN chmod +x bazelisk-linux-amd64 && mv bazelisk-linux-amd64 /usr/bin/bazel


# Install dependencies
RUN apt-get -y install python3-dev python-is-python3 libtinfo6 build-essential libxml2-dev liblapack-dev libblas-dev gfortran zip default-jdk

# Install development tools
RUN apt-get install -y git vim lldb

RUN useradd -m xls-developer
USER xls-developer

# Map the project contents in.
ADD --chown=xls-developer . /home/xls-developer/xls/
WORKDIR /home/xls-developer/xls/

# --- NEW CACHE AND TARGET CONFIGURATION ---
ARG BUILD_TARGET="//xls/common/..."

RUN mkdir -p /home/xls-developer/bazel_disk_cache && \
    echo "build --disk_cache=/home/xls-developer/bazel_disk_cache" >> /home/xls-developer/.bazelrc

# Test everything (opt), exclude contrib (including xlscc) for now due to
# increased build time when we add Clang.
RUN if [ "$SKIP_TESTS" != "1" ]; then bazel build --config=ci --lockfile_mode=update --check_direct_dependencies=off -c opt -- ${BUILD_TARGET}; else echo "Skipping tests because SKIP_TESTS is 1"; fi
